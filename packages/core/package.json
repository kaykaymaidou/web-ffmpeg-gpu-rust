{
  "name": "@web-ffmpeg-gpu/core",
  "version": "0.1.0",
  "description": "Web-FFmpeg GPU core SDK: Node remux (concatCopy/probe) + browser WebCodecs/WebGPU",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.js"
      },
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./web": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepack": "tsc",
    "test:node": "node --test test/concat-copy.test.mjs"
  },
  "keywords": [
    "ffmpeg",
    "webgpu",
    "webcodecs",
    "video-decoder",
    "hardware-acceleration"
  ],
  "author": "Web-FFmpeg-GPU Contributors",
  "license": "MIT",
  "devDependencies": {
    "@webgpu/types": "^0.1.72",
    "typescript": "^5.7.0"
  }
}
