# ==============================================================================
# Web-FFmpeg-GPU Monorepo Master .gitignore
# Strictly guards clean commits across Rust Core, Web SDK, Desktop & Services
# ==============================================================================

# --- Rust Build Targets ---
target/
**/target/
Cargo.lock.bak
*.rs.bk

# --- Node & Frontend Monorepo Packages ---
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.turbo/
.npm/

# --- WASM Generated Artifacts ---
*.wasm
!web/public/wasm/*.wasm
!packages/core/pkg/*.wasm
packages/core/pkg/.gitignore

# --- Native Desktop, Tauri & Windows Service Artifacts ---
src-tauri/target/
**/src-tauri/target/
bin/
obj/
*.exe
*.dll
*.so
*.dylib
*.pdb
*.lib
*.exp
*.ilk

# --- Media Fixtures & Temporary Dump Files ---
*.mp4
*.mkv
*.webm
*.flv
*.m2ts
*.ts.dump
tests/fixtures/**/*.ts
tests/benchmark/results/**/*.ts
apps/playground/public/**/*.ts
*.h264
*.264
*.h265
*.265
*.aac
*.opus
*.yuv
*.pcm
*.raw
!tests/fixtures/**/.gitkeep
tests/fixtures/bitrate-ladder/*.mp4
tests/fixtures/incoming/*.mp4
tests/benchmark/results/*
!tests/benchmark/results/.gitkeep
apps/playground/public/ffmpeg-wasm/
apps/playground/public/bench-clips/

# --- Test Outputs & Telemetry Harness ---
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/
.nyc_output/
*.profraw
*.profdata
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Environment & Secret Credentials ---
.env
.env.*
!.env.example

# --- IDE, OS & Agent Ephemeral Logs ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.tmp
*.temp
.harness/
.system_generated/
scratch/
