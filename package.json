{
  "name": "web-ffmpeg-gpu-root",
  "version": "0.1.0",
  "private": true,
  "description": "Next-Gen Web-FFmpeg Monorepo: WebCodecs GPU silicon direct path, WebGPU compute shader pipeline, pure Rust core, desktop C-ABI SDK, and instant wff CLI for sub-millisecond video editing, lossless trimming, concat, and filtergraph processing.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/playground",
    "build:core": "npm run build --workspace=packages/core",
    "build:agent": "npm run build --workspace=packages/agent",
    "build:mcp": "npm run build --workspace=packages/mcp-server",
    "build:playground": "npm run build --workspace=apps/playground",
    "build:cli": "vite build --config apps/cli/vite.config.ts",
    "build:wasm": "node scripts/build-wasm.mjs",
    "check:rust": "cargo check -p web-ffmpeg-core --target wasm32-unknown-unknown",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "build": "npm run build:core && npm run build:mcp && npm run build:agent && npm run build:cli && npm run build:playground",
    "wff": "node apps/cli/dist/index.js",
    "mcp": "node packages/mcp-server/dist/index.js",
    "test:e2e": "playwright test",
    "test:c-abi": "powershell -ExecutionPolicy Bypass -File scripts/test-c-abi.ps1",
    "test:cargo": "cargo test --workspace",
    "fetch:fixtures": "node scripts/fetch-real-fixtures.mjs",
    "bench:ffmpeg": "node scripts/bench-vs-ffmpeg.mjs",
    "bench:demux": "node --experimental-strip-types scripts/bench-demux-vs-ffmpeg.ts",
    "bench:wasm": "node scripts/sync-ffmpeg-wasm.mjs && playwright test tests/benchmark/ffmpeg-wasm-vs-webcodecs.spec.ts",
    "bench:layers": "node scripts/sync-ffmpeg-wasm.mjs && playwright test tests/benchmark/layer-matrix.spec.ts",
    "bench:vs-ffmpeg": "node scripts/bench-vs-ffmpeg.mjs && playwright test tests/benchmark/ffmpeg-vs-gpu.spec.ts",
    "preview": "npm run preview --workspace=apps/playground"
  },
  "keywords": [
    "ffmpeg",
    "web-ffmpeg",
    "wff",
    "webcodecs",
    "webgpu",
    "wgsl",
    "rust",
    "wasm",
    "video-editor",
    "video-processing",
    "lossless-cut",
    "video-trim",
    "video-concat",
    "demuxer",
    "muxer",
    "mp4",
    "webm",
    "mkv",
    "h264",
    "hevc",
    "av1",
    "aac",
    "opus",
    "audio-dsp",
    "resampler",
    "filtergraph",
    "hardware-acceleration",
    "capcut-web",
    "webrtc",
    "whip",
    "whep",
    "zero-copy",
    "media-autopilot"
  ],
  "author": "Web-FFmpeg-GPU Contributors",
  "license": "MIT",
  "devDependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@playwright/test": "^1.50.0",
    "@types/node": "^26.5.0",
    "@webgpu/types": "^0.1.72",
    "ffmpeg-static": "^5.3.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
