{
  "name": "web-ffmpeg-gpu-root",
  "version": "0.1.0",
  "private": true,
  "description": "Next-Gen Web-FFmpeg Monorepo with WebGPU Shader Pipelines & WebCodecs Hardware Acceleration",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/playground",
    "build:core": "npm run build --workspace=packages/core",
    "build:playground": "npm run build --workspace=apps/playground",
    "build:wasm": "cargo build --workspace --target wasm32-unknown-unknown --release",
    "check:rust": "cargo check --workspace --target wasm32-unknown-unknown",
    "build": "npm run build:core && npm run build:playground",
    "test:e2e": "playwright test",
    "preview": "npm run preview --workspace=apps/playground"
  },
  "keywords": [
    "ffmpeg",
    "webgpu",
    "webcodecs",
    "wasm",
    "rust",
    "video-processing",
    "hardware-acceleration"
  ],
  "author": "Web-FFmpeg-GPU Contributors",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@webgpu/types": "^0.1.72",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
